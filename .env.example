# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Never expose to client

# ─── App URL ──────────────────────────────────────────────────────────────────
# Must match exactly: used for email redirect links and Supabase auth
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get these from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...           # Use sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...         # From Stripe webhook endpoint config
# Price IDs from: Stripe Dashboard → Products → Prices
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ELITE_YEARLY=price_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=PLYAZ

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Get from: upstash.com → your Redis database → REST API
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── WhatsApp Notifications (Coming Soon) ────────────────────────────────────
# CALLMEBOT_API_KEY=your-key   # Uncomment when feature is activated
